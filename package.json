{
	"name": "bun-ws",
	"version": "1.0.0",
	"description": "Bun-based WebSocket proxy: VLESS server plus a VLESS client with local SOCKS/HTTP proxy",
	"main": "server/index.ts",
	"type": "module",
	"scripts": {
		"start": "bun run server/index.ts",
		"dev": "bun --watch server/index.ts",
		"client": "bun run client/bun-vlessclient.ts",
		"test": "bun test",
		"test:echo": "bun run scripts/min-echo-test.ts",
		"test:keepalive": "bun run scripts/keepalive-test.ts",
		"test:http": "bun run scripts/http-proxy-test.ts",
		"test:flow": "bun run scripts/flow-control-test.ts",
		"test:transfer": "bun run scripts/large-transfer-test.ts",
		"lint": "bunx @biomejs/biome check .",
		"build": "bun build server/index.ts --outdir ./dist --target bun --minify"
	},
	"keywords": [
		"bun",
		"websocket",
		"proxy",
		"vless",
		"socks5",
		"vpn",
		"reverse-proxy"
	],
	"author": "bun-ws contributors",
	"license": "Apache-2.0",
	"engines": {
		"bun": ">=1.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/yixunbfb/bun-ws.git"
	},
	"bugs": {
		"url": "https://github.com/yixunbfb/bun-ws/issues"
	},
	"homepage": "https://github.com/yixunbfb/bun-ws#readme"
}
